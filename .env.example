# Copy to .env for local dev (never commit the real .env).

# From your Upstox Developer app: https://upstox.com/developer/apps
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=
# Must exactly match a redirect URI registered on that Upstox app.
UPSTOX_REDIRECT_URI=http://localhost:5173/api/broker/upstox/callback

# Shared secret only you know, gates /api/broker/upstox/authorize so a
# visitor can't reconnect or hijack the site's one broker link. Any random
# string works; treat it like a password.
ADMIN_SECRET=

# 32-byte key, base64-encoded, used to encrypt the stored Upstox token at
# rest. Generate your own — do not reuse this example value:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Optional: only needed in production. Leave both unset locally and the app
# falls back to a local JSON file (.local-data/) for the token store.
# Set these once you add the Vercel KV (Upstash Redis) integration.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional accounts feature (username/password login, no email). Just two
# plain Postgres tables (app_users, portfolios) — any hosted Postgres works,
# e.g. a free Neon project (neon.tech): copy its pooled connection string.
# Leave both unset locally and the app works exactly the same, just without
# sign-in.
DATABASE_URL=
# Signs session tokens for logged-in users. Generate your own — do not reuse
# this example value:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=
